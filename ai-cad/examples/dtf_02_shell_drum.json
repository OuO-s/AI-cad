  "parameters": {
    "drum_dia": { "value": 1820, "min": 1500, "max": 2100, "description": "鼓体外径" },
    "drum_height": { "value": 420, "min": 300, "max": 600, "description": "鼓体高度" }
  },
  "features": [
    { "id": "drum", "type": "extrude", "profile": { "shape": "circle", "diameter": { "param": "drum_dia" } }, "plane_spec": { "plane": "XY" }, "distance": { "param": "drum_height" }, "mode": "new" },
    { "id": "drum_fillet", "type": "fillet", "depends_on": ["drum"], "radius": 30, "target": "drum", "edges": "top" }
  ]
