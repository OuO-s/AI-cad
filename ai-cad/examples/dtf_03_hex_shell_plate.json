  },
  "features": [
    { "id": "hex_plate", "type": "extrude", "profile": { "shape": "polygon", "sides": 6, "circumscribed_radius": { "param": "hex_radius" } }, "plane_spec": { "plane": "XY" }, "distance": { "param": "plate_thk" }, "mode": "new" },
    { "id": "hex_plate_fillet", "type": "fillet", "depends_on": ["hex_plate"], "radius": 12, "target": "hex_plate", "edges": "vertical" }
